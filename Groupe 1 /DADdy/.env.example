# ── Environnement ───────────────────────────────────
# Vide / "development" = mode dev : les secrets (JWT_SECRET, INTERNAL_API_KEY)
# retombent sur des valeurs de dev si non définis. Mettre "production" force
# leur présence : le service refuse de démarrer sans secret explicite.
APP_ENV=development

# ── core-api / core-db ──────────────────────────────
CORE_POSTGRES_USER=core_user
CORE_POSTGRES_PASSWORD=change-me-core
CORE_POSTGRES_DB=core

# ── user-service / user-db ──────────────────────────
USER_POSTGRES_USER=user_user  
USER_POSTGRES_PASSWORD=change-me-user
USER_POSTGRES_DB=users

# ── auth-service / auth-db ──────────────────────────
AUTH_POSTGRES_USER=auth_user
AUTH_POSTGRES_PASSWORD=change-me-auth
AUTH_POSTGRES_DB=auth

# ── JWT (auth + gateway) ────────────────────────────
JWT_SECRET=change-me-jwt-secret
JWT_PREVIOUS_SECRET=
JWT_ISSUER=daddy-auth
JWT_AUDIENCE=daddy-api
JWT_ALG=HS256
JWT_ACTIVE_KID=v1
JWT_PREVIOUS_KID=
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_PREVIOUS_PUBLIC_KEY_PATH=
JWT_LEEWAY_SECONDS=30
JWT_MAX_TOKEN_AGE_MINUTES=20
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ── Synchro interne auth → user-service ─────────────
# Clé partagée protégeant POST /internal/users (header X-Internal-Key).
INTERNAL_API_KEY=dev-internal-key

# ── Chiffrement des messages privés ─────────────────
# Secret serveur servant à dériver la clé AES-256 (chiffrement au repos du
# contenu des messages). À changer en prod : une rotation rend illisibles les
# messages déjà chiffrés.
MESSAGE_ENCRYPTION_KEY=dev-message-encryption-key

# ── MinIO (stockage médias / avatars) ───────────────
# Identifiants admin du serveur MinIO. À NE PAS laisser sur minioadmin:minioadmin
# (MinIO émet un warning et c'est une faille en prod). Min. 8 caractères pour le mot de passe.
MINIO_ROOT_USER=change-me-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
# Bucket public où sont stockés les avatars et médias des posts.
MINIO_BUCKET=breezy-media
# URL publique servie aux clients pour télécharger les objets (avatars, médias).
MINIO_PUBLIC_URL=http://localhost:9000

# ── notif-service / notif-db ────────────────────────
NOTIF_POSTGRES_USER=notif_user
NOTIF_POSTGRES_PASSWORD=change-me-notif
NOTIF_POSTGRES_DB=notifications

# ── CORS (api-gateway) ──────────────────────────────
# Origines autorisées : web dev + Capacitor iOS + Capacitor Android WebView
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost

# ── Cache (Valkey) — rate limiting du gateway ───────
# Mot de passe Valkey (requirepass). Requis si APP_ENV=production.
VALKEY_PASSWORD=change-me-valkey
# Limites de débit du gateway (requêtes/minute).
# AUTH : par IP sur /auth/* (anti brute-force). API : par utilisateur sur le reste.
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=120

# ── Vérification email (auth-service) ───────────────
# En dev (compose.override) : Mailpit capture tout, rien à définir ici
# (UI sur http://localhost:8025). Laisser SMTP_HOST vide => mailer en mode log :
# le lien de vérification est écrit dans les logs de l'auth-service.
# En prod : renseigner un relais SMTP réel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Expéditeur affiché des mails transactionnels.
MAIL_FROM=Breezy <no-reply@breezy.local>
# Base URL du front : construit les liens {APP_BASE_URL}/verify-email?token=...
# et {APP_BASE_URL}/reset-password?token=...
APP_BASE_URL=http://localhost:5173
# Durée de validité du lien de vérification (heures).
EMAIL_VERIFICATION_TTL_HOURS=24
# Durée de validité du lien de réinitialisation de mot de passe (minutes).
PASSWORD_RESET_TTL_MINUTES=60

# ── OAuth2 social login (auth-service) ──────────────
# Vide = provider désactivé. Renseigner en prod depuis la console Google/GitHub.
# Google: https://console.cloud.google.com/apis/credentials
# GitHub: https://github.com/settings/developers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
